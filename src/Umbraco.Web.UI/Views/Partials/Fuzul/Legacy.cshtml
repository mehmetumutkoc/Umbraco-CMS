@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{ var email = FuzulView.Text(Model, "email", "girisim@fuzulventures.com"); }
    <!-- Start Hero-->
    <div class="cs-header cs-header-style-2">
        <div class="hero-container container">
            <div class="row">
                <div class="hero-style-2">
                    <div class="hero-content hero-content-s tyle-2">
                        <div class="hero-heading">
                            <div data-aos="fade-up" data-aos-duration="1000"><span class="p-r-2">@FuzulView.Text(Model, "heroLine1", "Geleceği İnşa Etmenin")  </span></div>
                            <div data-aos="fade-up" data-aos-duration="1200"><span>@FuzulView.Text(Model, "heroLine2", "Vizyonuyla Bugüne")</span></div>
                            <div data-aos="fade-up" data-aos-duration="1500"><span class="p-r-2">@FuzulView.Text(Model, "heroLine3", "Yapılan Yatırım")</span></div>

                        </div>
                        <div class="hero-btn-with-text-style-2">
                            <div class="hero-subheading">
                                @FuzulView.Html(Model, "heroSubheading", "İnovasyonun ve girişimciliğin gücüne inanıyoruz ve vizyon sahibi, potansiyel dolu projeleri desteklemek amacıyla çalışıyoruz.")
                            </div>
                            <div class="cs_circle_btn_wrap hero-btn">
                                <div class="cs_round_btn_wrap_style_2">
                                    <a href="#kurumsal" class="cs_hero_btn cs_round_btn btn-item"><span></span>@FuzulView.Text(Model, "heroButton", "Yatırım Alanları")</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Hero-->

    <!-- Start About-->
    <section class="cs-about-style-2" id="kurumsal">
        <div class="container">
            <div class="row cs-item-middle">
                <div class="col-lg-12">
                    <div class="cs-about-content">
                        <div class="about-title">
                            <h2 class="wow animate__fadeInUp" data-wow-duration="0.5s">@FuzulView.Text(Model, "aboutTitle", "Seeding Funding")</h2>
                        </div>
                        <div class="cs-about-text">
                            @FuzulView.Html(Model, "aboutText", "Yatırımlarımız, geleceğin lider şirketlerinin temelini oluşturmak için stratejik ve uzun vadeli bir yaklaşımı yansıtır. Başarılı bir yatırım süreci için, girişimcilere sadece finansal destek sağlamakla kalmıyor, aynı zamanda zengin bir deneyim ve değerli bağlantılar sunuyoruz.")
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End About-->

    <!-- Investment sectors -->
<section class="cs-services-style-2 p-b-10">
 <div class="container"><div class="row services-style-2">
  <div class="cs-heading-style-2"><div class="heading-area-arrow">
   <div class="cs_circle_btn_wrap swiper-button-prev-team"><div class="cs_round_btn_wrap cs_round_btn_wrap_style_2"><a role="button" tabindex="0" aria-label="Önceki yatırım alanı" class="cs_hero_btn cs_round_btn btn-item"><span></span>@FuzulView.Text(Model, "sectorsPrev", "Geri")</a></div></div>
   <div class="cs_circle_btn_wrap swiper-button-next-team"><div class="cs_round_btn_wrap cs_round_btn_wrap_style_2"><a role="button" tabindex="0" aria-label="Sonraki yatırım alanı" class="cs_hero_btn cs_round_btn btn-item"><span></span>@FuzulView.Text(Model, "sectorsNext", "İleri")</a></div></div>
  </div></div>
  <div class="swiper cs-swiper-team"><div class="swiper-wrapper">
  @foreach (var block in FuzulView.Blocks(Model, "sectorItems"))
  {
   var item = block.Content;
   <div class="swiper-slide"><div class="service-style-2"><div class="service-container-2"><div class="service-style-2">
    <img src="@FuzulView.MediaUrl(item, "image", "/fuzul/images/h1.svg")" alt="" loading="lazy">
    <h4>@FuzulView.Text(item, "title", "")</h4><p>@FuzulView.Text(item, "text", "")</p>
   </div></div></div></div>
  }
  </div></div>
 </div></div>
</section>
    <!-- Investment process -->
<section class="p-x-10" id="surec"><div class="container-fluid cs-full-width"><div class="row cs-skills-wrapper">
 <div class="col-lg-2"><div class="title-left"><h2>@FuzulView.Text(Model, "processTitle", "Yatırım Süreci")</h2><span>@FuzulView.Text(Model, "processEyebrow", "Fuzul Ventures")</span></div></div>
 <div class="col-lg-10"><div class="skills-divider"></div><div class="cs-skill-items">
 @foreach (var block in FuzulView.Blocks(Model, "processSteps"))
 {
  var item = block.Content;
  <div class="cs-skill-item"><span>@FuzulView.Text(item, "number", "")</span>
   <div class="skill-title"><img src="@FuzulView.MediaUrl(item, "image", "/fuzul/images/r1.svg")" alt="" loading="lazy"><h3 class="cs-btn wow animate__fadeInUp" data-wow-duration="1s">@FuzulView.Text(item, "title", "")</h3></div>
   <div class="cs-skill-para"><p>@FuzulView.Text(item, "text", "")</p></div>
  </div>
 }
 </div></div>
</div></div></section>
    <!-- Investment committee -->
<section class="p-t-10" id="komite"><div class="container-fluid cs-full-width"><div class="row">
 <div class="col-lg-2"><div class="title-left"><h2>@FuzulView.Text(Model, "committeeTitle", "Yatırım Komitesi")</h2><span>@FuzulView.Text(Model, "committeeEyebrow", "Fuzul Ventures")</span></div></div>
 <div class="col-md-10"><div class="row">
 @foreach (var block in FuzulView.Blocks(Model, "committeeMembers"))
 {
  var item = block.Content;
  var memberId = "member-" + item.Key.ToString("N");
  var name = FuzulView.Text(item, "displayName", "");
  <div class="col-sm col-6">
   <a class="text-center" href="#@memberId" data-bs-toggle="modal" data-bs-target="#@memberId">
    <img class="member-details-image" src="@FuzulView.MediaUrl(item, "image", "/fuzul/images/farukakbal.png")" alt="@name" loading="lazy">
    <h3 class="fuzul-member-name">@name</h3>
   </a>
   <div class="modal fade" id="@memberId" tabindex="-1" aria-labelledby="@(memberId)-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
     <div class="modal-header"><h5 class="modal-title" id="@(memberId)-title">@FuzulView.Text(item, "modalTitle", name)</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
     <div class="modal-body">@FuzulView.Html(item, "bio", "")</div>
    </div></div>
   </div>
  </div>
 }
 </div></div>
</div></div></section>
    <!-- Start Contact Section -->
    <section class="p-tb-10" id="basvur">
        <div class="container">
            <div class="row cs-item-middle basvurrow">
                <div class="col-lg-6 col-sm-12">
                    <div class="cs-contact-page-content">
                        <h2 data-aos="zoom-in">@FuzulView.Text(Model, "applyTitle", "BAŞVURU FORMU")</h2>
                        @FuzulView.Html(Model, "applyText", "Girişiminizi geleceğe taşımak için bize ulaşın.")
                        <div class="member-contact-info">
                            <div class="contact-details">
                                <p>E-Mail</p>
                                <p class="color-white margin-0">@email</p>
                            </div>

                        </div>
                        <div class="member-social-link">
                            <p>Sosyal Medya</p>
                            <div class="member-details-social">
@foreach (var link in FuzulView.Links(Model, "socialLinks"))
{
 <a class="cs-btn" href="@link.Url" target="@link.Target" rel="noopener noreferrer"><p>@link.Name</p></a>
}
</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-12" data-aos="zoom-in">
                @using (Html.BeginUmbracoForm<FuzulFormsController>("Apply", null, new { @class = "cs-contact-form", id = "formbasvur", enctype = "multipart/form-data" }))
{
@Html.ValidationSummary(false, "", new { @class = "fuzul-validation", role = "alert" })


                        <ul>
                            <li class="grid grid-2">
                                <input type="text" placeholder="Girişimin Adı" aria-label="Girişimin Adı" name="StartupName" required>
                                <input type="text" placeholder="Web Adresi" aria-label="Web Adresi" name="Website" required>
                            </li>
                            <li>
                                <textarea aria-label="Girişiminizi Kısaca Anlatın" name="Summary" placeholder="Girişiminizi Kısaca Anlatın"></textarea>
                            </li>
                            <li>
                                <select aria-label="Faaliyet Alanı" name="Industry">
                                <option value="" selected disabled>Faaliyet Alanı</option>
                                <option>İnşaat Teknolojileri</option>
                                <option>Gayrimenkul Teknolojileri</option>
                                <option>Yenilenebilir Enerji ve İklim Teknolojileri</option>
                                <option>Ulaştırma Teknolojileri</option>      
                                <option>Diğer</option>      
                              </select>
                            </li>
                            
                            <li class="grid grid-2">
                                <input type="text" name="FounderName" placeholder="Kurucunun İsmi" aria-label="Kurucunun İsmi" required>
                                <input type="email" name="FounderEmail" placeholder="Kurucunun E-Posta Adresi" aria-label="Kurucunun E-Posta Adresi" required>
                            </li>
                            <li>
                                <p>Yatırım Sunumunuzu Ekleyin</p>
                                <input type="file" accept="application/pdf,.pdf" name="Presentation" placeholder="Kurucunun İsmi" aria-label="Kurucunun İsmi" required>
                                <span>Sadece PDF</span>
                            </li>
                            <li>
                                <button class="" type="submit">
                    <span class="">BAŞVUR</span>
                  </button>
                  @if (TempData["FuzulApplySuccess"] is string message) { <div class="fuzul-form-status" role="status">@message</div> }

                            </li>
                        </ul>
                    
}
                </div>
            </div>
        </div>
    </section>
    <!-- End Contact Section -->
    <section class="p-tb-10" id="contact">
        <div class="container">
            <div class="row cs-item-middle basvurrow">
                <div class="col-lg-6 col-sm-12">
                    <div class="cs-contact-page-content">
                        <h2 data-aos="zoom-in">@FuzulView.Text(Model, "contactTitle", "İLETİŞİM")</h2>
                        @FuzulView.Html(Model, "contactText", "İletişim formunu doldurarak bizimle iletişime geçebilirsiniz.")
                        <div class="member-contact-info">
                            <div class="contact-details">
                                <p>E-Mail</p>
                                <p class="color-white margin-0">@email</p>
                            </div>

                        </div>
                        <div class="member-social-link">
                            <p>Sosyal Medya</p>
                            <div class="member-details-social">
@foreach (var link in FuzulView.Links(Model, "socialLinks"))
{
 <a class="cs-btn" href="@link.Url" target="@link.Target" rel="noopener noreferrer"><p>@link.Name</p></a>
}
</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-12" data-aos="zoom-in">
                @using (Html.BeginUmbracoForm<FuzulFormsController>("Contact", null, new { @class = "cs-contact-form", id = "formcontact", enctype = "multipart/form-data" }))
{
@Html.ValidationSummary(false, "", new { @class = "fuzul-validation", role = "alert" })


                        <ul>
                            <li class="grid grid-3">
                                <input type="text" placeholder="Ad Soyad" aria-label="Ad Soyad" name="FullName" required>
                                <input type="text" placeholder="Telefon" aria-label="Telefon" name="Phone" required>
                                <input type="email" placeholder="Email" aria-label="Email" name="Email" required>
                            </li>
                           
                          
                            <li>
                                <p>Dosya Yükle</p>
                                <input type="file" accept="application/pdf,.pdf" name="Attachment" placeholder="Dosya Yükle" aria-label="Dosya Yükle">
                                <span>Sadece PDF</span>
                            </li>
                            <li>
                                <button class="" type="submit">
                    <span class="">Gönder</span>
                  </button>
                  @if (TempData["FuzulContactSuccess"] is string message) { <div class="fuzul-form-status" role="status">@message</div> }

                            </li>
                        </ul>
                    
}
                </div>
            </div>
        </div>
    </section>


