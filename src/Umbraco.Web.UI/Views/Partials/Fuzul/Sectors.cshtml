@model FuzulSectionModel
@{
    var carousel = Model.Text("layout", "Karusel") != "Izgara";
    var columns = FuzulBuilder.Number(Model.Text("columns"), 4, 1, 5);
    var items = FuzulView.Blocks(Model.Content, "sectorItems");
}
<section id="@Model.Anchor" class="cs-services-style-2 p-b-10 @Model.Class" style="@Model.Style" data-fv-stage="@Model.Key">
    <div class="container">
        <div class="row services-style-2">
            @if (!string.IsNullOrWhiteSpace(Model.Text("title")))
            {
                <h2>@Model.Text("title")</h2>
            }
            @if (carousel)
            {
                <div class="cs-heading-style-2">
                    <div class="heading-area-arrow">
                        <div class="cs_circle_btn_wrap swiper-button-prev-team">
                            <div class="cs_round_btn_wrap cs_round_btn_wrap_style_2">
                                <a role="button" tabindex="0" aria-label="Önceki yatırım alanı" class="cs_hero_btn cs_round_btn btn-item"><span></span>@Model.Text("sectorsPrev", "Geri")</a>
                            </div>
                        </div>
                        <div class="cs_circle_btn_wrap swiper-button-next-team">
                            <div class="cs_round_btn_wrap cs_round_btn_wrap_style_2">
                                <a role="button" tabindex="0" aria-label="Sonraki yatırım alanı" class="cs_hero_btn cs_round_btn btn-item"><span></span>@Model.Text("sectorsNext", "İleri")</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="swiper cs-swiper-team" data-columns="@columns">
                    <div class="swiper-wrapper">
                        @foreach (var block in items)
                        {
                            <div class="swiper-slide">
                                <div class="service-style-2">
                                    <div class="service-container-2">
                                        <div class="service-style-2">
                                            <img src="@FuzulView.MediaUrl(block.Content, "image", "/fuzul/images/h1.svg")" alt="" loading="lazy">
                                            <h4>@FuzulView.Text(block.Content, "title", "")</h4>
                                            <p>@FuzulView.Text(block.Content, "text", "")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="fv-grid" style="--fv-columns:@columns">
                    @foreach (var block in items)
                    {
                        <div class="service-style-2">
                            <div class="service-container-2">
                                <div class="service-style-2">
                                    <img src="@FuzulView.MediaUrl(block.Content, "image", "/fuzul/images/h1.svg")" alt="" loading="lazy">
                                    <h4>@FuzulView.Text(block.Content, "title", "")</h4>
                                    <p>@FuzulView.Text(block.Content, "text", "")</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    @await Html.PartialAsync("~/Views/Partials/Fuzul/Widgets.cshtml", Model)
</section>
